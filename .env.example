# Kelta Local Development Environment Variables
# ─────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Generate dev keys: make gen-keys
#    (appends JWK_SET and KELTA_ENCRYPTION_KEY to .env)
# 3. Start the stack: make up
#
# Secrets below are DEV-ONLY. Never use these values in any deployed environment.

# ─────────────────────────────────────────────
# Authentication — kelta-auth
# ─────────────────────────────────────────────

# RSA JWK Set for JWT signing. Generated by `make gen-keys`.
# Format: single-line JSON {"keys":[{...RS256 private key...}]}
JWK_SET=

# AES-256 master key for envelope encryption (Base64-encoded 32 bytes).
# Generated by `make gen-keys` via: openssl rand -base64 32
KELTA_ENCRYPTION_KEY=

# Shared secret for internal service-to-service calls
KELTA_INTERNAL_TOKEN=dev-internal-token

# ─────────────────────────────────────────────
# AI service — kelta-ai (only needed with --profile ai)
# ─────────────────────────────────────────────

ANTHROPIC_API_KEY=

# Optional: override default Claude model
# AI_DEFAULT_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────
# Browser Web Push — kelta-worker (optional)
# ─────────────────────────────────────────────

# VAPID application-server keys (RFC 8292). Generate with `make gen-vapid`.
# Public key: base64url uncompressed P-256 point (what a browser passes to
# pushManager.subscribe). Private key: its raw base64url scalar.
# Leave empty to run without browser push — native push is unaffected.
# Rotating these invalidates every existing browser subscription.
# KELTA_PUSH_VAPID_PUBLIC_KEY=
# KELTA_PUSH_VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URI — Safari rejects anything else.
# KELTA_PUSH_VAPID_SUBJECT=mailto:admin@localhost

# ─────────────────────────────────────────────
# IP geolocation — kelta-gateway (optional)
# ─────────────────────────────────────────────

# Free license key from a MaxMind account (https://www.maxmind.com/en/geolite2/signup).
# Enables automatic GeoLite2-City downloads; leave empty to run without geo enrichment.
# MAXMIND_LICENSE_KEY=

# ─────────────────────────────────────────────
# Logging overrides (optional)
# ─────────────────────────────────────────────

# LOG_LEVEL=INFO
# SECURITY_LOG_LEVEL=WARN
